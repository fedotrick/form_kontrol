# Flask Configuration
SECRET_KEY=your-secret-key-here

# Google Sheets Configuration
# Option 1: Use service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# Option 2: Use service account JSON content directly (for deployment)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Sheet IDs (get these from Google Sheets URLs)
PLAVKA_SHEET_ID=your-plavka-sheet-id-here
CONTROL_SHEET_ID=your-control-sheet-id-here

# Alternative: Use sheet names instead of IDs
CONTROL_SHEET_NAME=Control Data

# Development settings
FLASK_ENV=development
FLASK_DEBUG=True