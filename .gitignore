# Игнорирование папок сборки и дистрибутива
/build/
/dist/
/temp/

# Игнорирование файлов больше 50MB
# (Git не поддерживает фильтрацию по размеру файла напрямую, 
# но можно перечислить конкретные большие файлы)
*.zip
*.exe
*.dll
*.pyd
*.pkg
*.pyz
Электронный_журнал_контроля.zip
Электронный\ журнал\ контроля.exe

# Конкретные проблемные файлы
build/app/PYZ-00.pyz
build/app/Электронный\ журнал\ контроля.exe
build/app/Электронный\ журнал\ контроля.pkg
dist/Электронный\ журнал\ контроля/_internal/PySide6/Qt6WebEngineCore.dll
dist/Электронный\ журнал\ контроля/_internal/torch/lib/torch_cpu.dll

# Файлы Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Виртуальные окружения
env/
venv/
ENV/

# Кэши и временные файлы
.cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Файлы IDE
.idea/
.vscode/
*.swp
*.swo

# Прочие файлы, которые не нужны в репозитории
*.log
*.spec
controllers.txt 